{
  "name": "game-translator",
  "version": "1.2.0",
  "description": "Adaptive game translation: wiki context + LLM comparison of game localizations",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node --check assets/app.js && node --check assets/chat.js && node --check assets/about.js",
    "test": "node --test tests/",
    "eval": "node scripts/eval.js",
    "build": "node netlify/build.js",
    "tavily:check": "node check-tavily.js",
    "chat:redteam": "node scripts/chat-injection-eval.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonid4D/GameTranslator.git"
  },
  "keywords": [
    "game-translation",
    "localization",
    "llm",
    "fandom",
    "wikipedia"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Leonid4D/GameTranslator/issues"
  },
  "homepage": "https://github.com/Leonid4D/GameTranslator#readme",
  "dependencies": {
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "serverless-http": "^4.0.0",
    "yookassa-api-sdk": "^0.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
