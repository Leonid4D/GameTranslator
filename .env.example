# Скопируйте в Keys.env и заполните реальными значениями.
# Keys.env уже есть в .gitignore — ключи не попадут в репозиторий.

PORT=3000

# --- LLM (OpenAI-совместимый эндпоинт: OpenAI, DeepSeek, OpenRouter, локальный Ollama) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-chat
# Таймаут запроса к модели, мс
LLM_TIMEOUT_MS=60000
# Максимальная длина ответа: защищает бюджет от «разговорившейся» модели
LLM_MAX_TOKENS=1600
# Структурированный JSON-ответ: auto (по умолчанию) / on / off
LLM_JSON_MODE=auto
# 1 — демо-режим без вызовов LLM и внешних сервисов (тесты, показ интерфейса)
MOCK_LLM=

# --- Tavily (веб-контекст для Pro-режима). Оставьте пустым, чтобы отключить ---
TAVILY_API_KEY=

# Чем искать в интернете для Pro: auto (Tavily → DuckDuckGo), tavily, duckduckgo, off
WEB_SEARCH_PROVIDER=auto

# Сколько максимум ждём веб-поиск, мс. На Netlify free (лимит функции ~10 с)
# поставьте 3000–5000, иначе Pro-запрос не успеет дойти до модели.
WEB_SEARCH_TIMEOUT_MS=10000

# Автодополнение терминов (/api/suggest). 0 — выключить
SUGGEST_ENABLED=1

# Максимум LLM-запросов в сутки на инстанс (0 — без лимита)
LLM_DAILY_LIMIT=0

# --- Мини-чат «Обсудить перевод» ---
# 0 — полностью выключить чат (kill-switch; на Netlify требует редеплоя).
CHAT_ENABLED=1
# Секрет подписи сессии чата. Это НЕ ключ провайдера, а случайная строка ≥32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Без ключа в production чат выключен (fail-closed), в dev — ключ на процесс.
CHAT_SIGNING_KEY=
# Время жизни chatToken, сек (по умолчанию 30 минут)
CHAT_TTL_SEC=1800
# Лимит ответа модели и таймаут (serverless Netlify обрывает функцию ~на 10 с)
CHAT_MAX_TOKENS=700
CHAT_TIMEOUT_MS=8000
# Лимиты входа/истории/ответа
CHAT_MAX_USER_MESSAGE=1000
CHAT_MAX_HISTORY=8
CHAT_MAX_HISTORY_CHARS=6000
CHAT_MAX_ACTIONS=3
CHAT_MAX_REPLY_CHARS=2000
# Rate limit чата: 12 сообщений в минуту и 150 в сутки на IP
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=12
CHAT_DAILY_PER_IP=150
# Модель для чата (пусто — LLM_MODEL). Можно дешевле, например deepseek-chat.
CHAT_MODEL=

# Прокси только для запросов к Tavily (http://user:pass@host:port).
# Нужен, если Tavily отвечает 403 из-за блокировки IP/региона на уровне CDN.
TAVILY_PROXY=

# --- ЮKassa (оплата). Пока не заполнено — /api/create-payment отвечает 503 ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Прочее (необязательно) ---
# Куда вернуть пользователя после оплаты
FRONTEND_ORIGIN=https://leonid4d.github.io/GameTranslator
# Ограничение источников CORS через запятую; пусто = разрешены все
CORS_ORIGINS=
# Лимит запросов на IP за окно
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40
